FROM python:3.13-slim
WORKDIR /app

RUN pip install --no-cache-dir \
    "sqlalchemy>=2.0" \
    "alembic>=1.14" \
    "psycopg2-binary>=2.9" \
    "python-dateutil>=2.9"

COPY backend/app ./app
COPY backend/migrations ./migrations
COPY backend/alembic.ini .

# Run migrations then seed
CMD ["sh", "-c", "PYTHONPATH=/app alembic upgrade head && PYTHONPATH=/app python -m app.seed.run"]
